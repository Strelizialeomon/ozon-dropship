# hub-backup 的环境配置
# 安装：复制到 /etc/fulfillment-hub/backup.env，改掉值，chmod 600 root:root。

# mysqldump 凭据文件（见 backup.cnf.example）
MYSQL_CNF=/etc/fulfillment-hub/backup.cnf

# 数据库名
DB_NAME=fulfillment_hub

# MySQL binlog 目录（PITR 必需）。先确认：mysql -e "SHOW VARIABLES LIKE 'log_bin_basename'"
# 脚本只外送该目录下 binlog.<数字> 的文件——即使和 mysql 数据同目录（默认 /var/lib/mysql），
# 也不会把整个数据目录拖走。
BINLOG_DIR=/var/lib/mysql

# 本机暂存目录（dump 先落这里，再外送）
LOCAL_DIR=/var/backups/fulfillment-hub

# 保留天数（ADR：全量与 binlog 各保留 30 天）
RETENTION_DAYS=30

# ── 外送目的地：〔二选一，另一个留空〕─────────────────────────────
# A. 另一台机器（ssh 可达；先把 root@本机 的公钥放到备份机）
# RSYNC_REMOTE=root@backup.example.com:/data/fulfillment-hub
RSYNC_REMOTE=
# B. 对象存储（先 rclone config 配好 remote，名字自取；示例兼容 S3）
# RCLONE_REMOTE=s3:my-bucket/fulfillment-hub
RCLONE_REMOTE=
